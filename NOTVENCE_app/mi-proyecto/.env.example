# Copia este archivo a ".env.local" y pon la IP de tu PC en la misma red
# que el celular/emulador (donde corre "uvicorn app.main:app --host 0.0.0.0").
#
# - Dispositivo físico o emulador iOS: usa la IP LAN de tu PC, ej: http://192.168.1.50:8000
# - Emulador Android (AVD): usa http://10.0.2.2:8000 (alias del host desde el emulador)
# - Expo Web: usa http://127.0.0.1:8000
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
